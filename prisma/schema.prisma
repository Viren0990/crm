// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Lead ──────────────────────────────────────────
model Lead {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  email         String?
  company       String?
  city          String?
  address       String?
  type          String    @default("B2C")      // "B2B" | "B2C" | "Both"
  source        String?                         // "Website", "Referral", "Cold Call", etc.
  staff         String?                         // Assigned staff name
  priority      String    @default("WARM")      // "HOT" | "WARM" | "COLD"

  // Communication tracking
  whatsappSent  Boolean   @default(false)
  called        Boolean   @default(false)

  // Status within Leads stage
  status        String    @default("NEW")       // "NEW" | "CONTACTED" | "QUALIFIED" | "DEMO_SCHEDULED" | "LOST"

  followUpDate  DateTime?

  // Relationships
  demo          Demo?
  activities    Activity[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([staff])
  @@index([priority])
}

// ── Demo ──────────────────────────────────────────
model Demo {
  id            String    @id @default(cuid())
  leadId        String    @unique
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime
  conductedBy   String
  type          String                          // "B2B" | "B2C" | "Both"
  duration      Int?                            // Minutes

  status        String    @default("PENDING")   // "PENDING" | "SUCCESSFUL" | "FAILED" | "RESCHEDULED" | "NO_SHOW"
  result        String?   @db.Text
  notes         String?   @db.Text

  followUpDate  DateTime?
  followUpNotes String?   @db.Text

  onboarding    Onboarding?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

// ── Onboarding ────────────────────────────────────
model Onboarding {
  id                    String    @id @default(cuid())
  demoId                String    @unique
  demo                  Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  status                String    @default("PENDING")   // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "ON_HOLD"
  assignedTo            String?

  // Checklist
  registrationEmail     Boolean   @default(false)
  registeredEnrollment  Boolean   @default(false)
  paymentReceived       Boolean   @default(false)
  paymentAmount         Float?
  onboardingEmail       Boolean   @default(false)
  onboardingCall        Boolean   @default(false)
  documentsCollected    Boolean   @default(false)

  notes                 String?   @db.Text
  completedAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
}

// ── Activity Log ──────────────────────────────────
model Activity {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        String    // "NOTE" | "STATUS_CHANGE" | "DEMO_SCHEDULED" | "DEMO_RESULT" | "ONBOARDING_UPDATE" | "CALL" | "WHATSAPP" | "FOLLOW_UP"
  title       String    // Short description: "Status changed to Qualified"
  description String?   @db.Text   // Detailed content (for notes)
  performedBy String?              // Staff who did this

  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([createdAt])
}
